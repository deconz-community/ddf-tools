// For format details, see https://aka.ms/devcontainer.json. For config options, see the README at:
// https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
  "name": "Node.js & TypeScript",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "antfu.iconify",
        "antfu.vite",
        "antfu.goto-alias",
        "csstools.postcss",
        "dbaeumer.vscode-eslint",
        "Vue.volar",
        "streetsidesoftware.code-spell-checker",
        "yy0931.vscode-sqlite3-editor",
        "Tobermory.es6-string-html",
        "mhutchie.git-graph",
        "eamodio.gitlens",
        "GitHub.copilot-chat",
        "statelyai.stately-vscode",
        "yoavbls.pretty-ts-errors",
        "vitest.explorer",
        "christian-kohler.npm-intellisense",
        "MylesMurphy.prettify-ts",
        "sissel.shopify-liquid",
        "github.vscode-github-actions",
        "VoidZero.vite-plus-extension-pack"
      ]
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "moby": false
    },
    "ghcr.io/tailscale/codespace/tailscale": {}
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],

  "runArgs": ["--hostname=ddf-tools-dev"],

  "postCreateCommand": "vp install && vp install -g @anthropic-ai/claude-code",
  // "postStartCommand": "t3 up --lan --yes",

  // Comment out to connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root.
  "remoteUser": "vp",
  "appPort": ["3000:3000", "4000:4000", "8080:8080"],
  "portsAttributes": {
    "4000": {
      "label": "Toolbox - Vitesse"
    },
    "3000": {
      "label": "Store API"
    },
    "8080": {
      "label": "VS Code Extension - Live Server"
    }
  }
}

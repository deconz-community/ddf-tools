HOST=127.0.0.1
PORT=3000

# Directory where the database file is stored.
DATABASE_PATH=./data/store.db
# Directory where user avatars are stored as <user id>.png/jpg.
AVATAR_PATH=./data/avatars

CORS_ORIGINS=http://localhost:4000
TOOLBOX_URL=http://localhost:4000

# Set both values to enable verification and password-reset email delivery.
SMTP_URL=
SMTP_FROM=

# Defaults to true in production and false otherwise.
SECURE_COOKIES=

# System signing secrets are required only when publishing beta or stable bundles.
BETA_PRIVATE_KEY=
STABLE_PRIVATE_KEY=
DEPRECATED_PRIVATE_KEY=
